# Nenhum provedor é obrigatório. Faltar credencial de um deles desabilita
# aquele toolset e a correlação segue com as fontes restantes — o servidor
# sobe do mesmo jeito.
#
# ONDE ESTE ARQUIVO SERVE, E ONDE NÃO SERVE
#
# Serve: máquina de desenvolvedor, transporte stdio. Copie para `.env` (está
# no .gitignore) e aponte com `--env-file`.
#
# Não serve: o transporte HTTP, onde o servidor é um processo de vida longa e
# compartilhada. Ali um arquivo em texto plano não é aceitável — use
# `--secrets-dir /run/secrets`, com um arquivo por credencial, nomeado igual à
# variável. Docker e Kubernetes montam nesse formato; veja o
# docker-compose.yml. Diferente de variável de ambiente, um segredo montado
# não aparece em `docker inspect`.
#
# Precedência: variável de ambiente > --secrets-dir > --env-file > default.

# ----------------------------------------------------------------- FullStory
FULLSTORY_API_KEY=
FULLSTORY_ORG_ID=
# US (padrão) ou EU1
FULLSTORY_DATACENTER=US

# ------------------------------------------------------------------- Datadog
# As DUAS chaves são necessárias: a API Key sozinha só permite envio, não leitura.
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com
# Opcionais, quando logs ou métricas vivem em outro site:
# DD_LOGS_SITE=
# DD_METRICS_SITE=

# ---------------------------------------------------------------- ServiceNow
# Só o nome da instância; o domínio é completado automaticamente.
SNOW_INSTANCE=
SNOW_AUTH=basic
SNOW_USERNAME=
SNOW_PASSWORD=
# Com SNOW_AUTH=oauth2, use estes no lugar de usuário/senha:
# SNOW_CLIENT_ID=
# SNOW_CLIENT_SECRET=

# ----------------------------------------------------- Microsoft Graph
# ⚠️ Ler mensagens de Teams exige ChannelMessage.Read.All — permissão de
# aplicação com consentimento de administrador. Peça cedo: costuma demorar.
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=

# ---------------------------------------------------------------- Correlação
# Atributo de log que carrega a identidade do usuário. Ajuste para a convenção
# do seu app; sem ele, `find_sessions_for_incident` não consegue resolver quem
# foi afetado.
FS_DD_USER_ATTR=@usr.id
# time | identity | both
FS_DD_CORRELATION_MODE=both
FS_DD_WINDOW_PADDING_SECONDS=60

# ----------------------------------------------------------------------- LLM
# Desligado por padrão. 'openai-compat' aponta para qualquer endpoint
# compatível — com um modelo local, nenhum dado sai da rede.
MCP_LLM_PROVIDER=none
# MCP_LLM_MODEL=
# MCP_LLM_BASE_URL=http://localhost:11434/v1
# MCP_LLM_API_KEY=
MCP_LLM_EFFORT=medium
MCP_LLM_MAX_TIMELINE_ENTRIES=300

# ------------------------------------------------------------------ Servidor
MCP_PROFILE=ide
# MCP_TOOLSETS=          # lista explícita; tem precedência sobre o perfil
SAFE_MODE=false
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TOOL_MAX_REQUESTS=60

# ------------------------------------------------- OAuth (só no modo HTTP)
MCP_AUTH_ENABLED=false
# MCP_SERVER_CANONICAL_URI=https://mcp.exemplo.com
# MCP_AUTH_SERVER_URL=https://auth.exemplo.com
# MCP_AUTH_JWKS_URL=https://auth.exemplo.com/.well-known/jwks.json
# MCP_AUTH_REQUIRED_SCOPES=mcp:read

# ------------------------------------------------------- Modo demo / proxy
# Override do host upstream. Usado por scripts/demo_upstream.py para exercitar
# a correlação sem conta real, e por quem precisa de proxy corporativo.
# FULLSTORY_BASE_URL=http://127.0.0.1:8931
# DD_BASE_URL=http://127.0.0.1:8931
