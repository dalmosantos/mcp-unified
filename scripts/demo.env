export FULLSTORY_BASE_URL=http://127.0.0.1:8931

export DD_API_KEY=demo
export DD_APP_KEY=demo
export DD_BASE_URL=http://127.0.0.1:8931

export SNOW_INSTANCE=demo
export SNOW_USERNAME=demo
export SNOW_PASSWORD=demo

export FS_DD_USER_ATTR=@usr.id
export MCP_PROFILE=all
